APP_ENV=development
DATABASE_URL=sqlite:///../data/tupai.db
JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=tupai-demo
AILY_SKILL_API_KEY=replace-with-a-shared-secret
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 飞书生产连接：在开放平台创建自建应用，开启多维表格读写权限，并将密钥只放入部署环境变量
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
# 资源到多维表格 table_id 的映射；每个资源都必须配置后才允许同步
FEISHU_TABLE_MAP={"teachers":"tbl教师","class_groups":"tbl班级","rooms":"tbl教室","time_slots":"tbl时段","course_sessions":"tbl课程场次","rules":"tbl规则","schedule":"tbl课表"}
