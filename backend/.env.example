APP_ENV=development
DATABASE_URL=sqlite:///../data/tupai.db
JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=tupai-demo
AILY_SKILL_API_KEY=replace-with-a-shared-secret
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 飞书生产连接：只配置一次应用凭据；多维表格和数据表由管理员授权后自动创建
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 生成命令：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FEISHU_TOKEN_ENCRYPTION_KEY=
# 必须与飞书开放平台“安全设置 -> 重定向 URL”完全一致
FEISHU_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/feishu/oauth/callback
FRONTEND_URL=http://127.0.0.1:5173
